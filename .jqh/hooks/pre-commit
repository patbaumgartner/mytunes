#!/bin/sh
# Java Quality Harness pre-commit gate.
#
# Runs the same checks, with the same configuration and the same thresholds, that CI
# runs. It is a thin wrapper on purpose: any logic added here would make the local
# result diverge from the CI result, which is the failure this harness exists to
# prevent.
#
# Enable with:  git config core.hooksPath .jqh/hooks
set -eu

if [ -n "${JQH_SKIP:-}" ]; then
  echo "jqh: JQH_SKIP is set, so this commit was NOT validated." >&2
  exit 0
fi

MVN="./mvnw"
[ -x "$MVN" ] || MVN="mvn"

echo "jqh: running the pre-commit tier..."
if ! "$MVN" -q -B jqh:check -Djqh.tier=pre-commit; then
  echo "" >&2
  echo "jqh: commit blocked. A remediation prompt for a coding agent is at:" >&2
  echo "     target/jqh/jqh-agent-prompt.md" >&2
  echo "" >&2
  echo "     Fix the findings. Do not disable checks, lower thresholds, add broad" >&2
  echo "     suppressions, or weaken tests to get past this gate." >&2
  exit 1
fi
